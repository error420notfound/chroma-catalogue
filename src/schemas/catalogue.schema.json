{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chroma-catalogue.dev/schemas/catalogue.schema.json",
  "title": "Chroma Catalogue Entry",
  "oneOf": [{ "$ref": "#/$defs/hueScale" }, { "$ref": "#/$defs/engineeredHue" }],
  "$defs": {
    "color": {
      "type": "object",
      "required": ["hex", "oklch"],
      "properties": {
        "hex": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "oklch": {
          "type": "object", "required": ["l", "c", "h"],
          "properties": { "l": { "type": "number", "minimum": 0, "maximum": 1 }, "c": { "type": "number", "minimum": 0, "maximum": 0.5 }, "h": { "type": "number", "minimum": 0, "maximum": 360 }, "alpha": { "type": "number", "minimum": 0, "maximum": 1 } },
          "additionalProperties": false
        },
        "displayP3": {
          "type": "object",
          "required": ["r", "g", "b"],
          "properties": {
            "r": { "type": "number", "minimum": 0, "maximum": 1 },
            "g": { "type": "number", "minimum": 0, "maximum": 1 },
            "b": { "type": "number", "minimum": 0, "maximum": 1 },
            "alpha": { "type": "number", "minimum": 0, "maximum": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    },
    "presentation": {
      "type": "object",
      "properties": { "displayOpacity": { "type": "number", "minimum": 0, "maximum": 1 }, "textColor": { "oneOf": [{ "const": "auto" }, { "$ref": "#/$defs/color" }] }, "contrastExamples": { "type": "array", "items": { "$ref": "#/$defs/contrastExample" } } }
    },
    "contrastExample": {
      "type": "object",
      "required": ["id", "label", "foreground", "background"],
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "foreground": { "$ref": "#/$defs/color" },
        "background": { "$ref": "#/$defs/color" },
        "sampleText": { "type": "string" }
      },
      "additionalProperties": false
    },
    "referenceColor": {
      "type": "object",
      "required": ["id", "label", "color"],
      "properties": { "id": { "type": "string" }, "label": { "type": "string" }, "color": { "$ref": "#/$defs/color" } },
      "additionalProperties": false
    },
    "hueScale": {
      "type": "object", "required": ["id", "type", "name", "slug", "steps"],
      "properties": { "id": { "type": "string" }, "type": { "const": "scale" }, "name": { "type": "string" }, "slug": { "type": "string" }, "description": { "type": "string" }, "tags": { "type": "array", "items": { "type": "string" } }, "steps": { "type": "array", "minItems": 1, "items": { "allOf": [{ "$ref": "#/$defs/presentation" }, { "type": "object", "required": ["step", "color"], "properties": { "step": { "enum": [50, 100, 200, 300, 400, 500, 600, 700, 800, 900, 950] }, "color": { "$ref": "#/$defs/color" }, "label": { "type": "string" } } }] } }, "referenceColors": { "type": "array", "items": { "$ref": "#/$defs/referenceColor" } }, "contrastExamples": { "type": "array", "items": { "$ref": "#/$defs/contrastExample" } } },
      "additionalProperties": false
    },
    "engineeredHue": {
      "type": "object", "required": ["id", "type", "name", "slug", "color"],
      "properties": { "id": { "type": "string" }, "type": { "const": "engineered" }, "name": { "type": "string" }, "slug": { "type": "string" }, "description": { "type": "string" }, "tags": { "type": "array", "items": { "type": "string" } }, "color": { "$ref": "#/$defs/color" }, "relatedScaleId": { "type": "string" }, "pantoneReference": { "type": "object", "required": ["code"], "properties": { "code": { "type": "string" }, "system": { "type": "string" }, "verified": { "type": "boolean" } }, "additionalProperties": false } },
      "additionalProperties": false
    }
  }
}
